# Copy to scripts/release.env (gitignored) and edit.
# Where releases are published: "github" (the public source repo) or "local:<dir>" (for testing, no network).
RELEASE_TARGET=github
# The public repo releases go to (the source mirror, scripts/oss-export.sh). This is the default.
RELEASES_REPO=gobinda168/glance-studio
# The old releases-only repo: also gets each appcast + DMG while builds that check its feed are still around. Remove
# this line to end the bridge, then archive that repo (archived release downloads keep working).
LEGACY_RELEASES_REPO=gobinda168/glance-releases
# local target only: the URL the directory is served at, e.g. python3 -m http.server 8000 --directory <dir>
# RELEASE_BASE_URL=http://localhost:8000
